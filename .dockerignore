# Keep the image lean and free of local/host-only state. Real campaign data
# (the SQLite DBs + uploaded avatars/maps) lives on the mounted volume at /data,
# never in the image.
#
# NOTE ON PATTERNS: Docker matches .dockerignore entries with Go's
# filepath.Match, which is NOT recursive. A bare `*.db` matches only files in
# the build-context root — it does *not* match `campaigns/campaign.db` or
# `dev_backup/campaign.db`. Nested matches need the `**/` prefix. Getting this
# wrong silently bakes real campaign data into the image.
.git
.gitignore
.venv
venv
env
__pycache__
*.pyc
*.pyo

# Databases, at any depth. Prod uses /data on the persistent volume.
*.db
**/*.db

# Per-campaign storage and the active-campaign pointer — host state only.
campaigns/
active_campaign
dev_backup/

# Local uploads — prod stores these on the volume (/data/avatars, /data/maps).
# The Dockerfile also symlinks both onto the volume.
static/avatars/
static/maps/

# Dev/test artifacts
seed_test_db.py
seed_demo.py
scripts/
.playwright-mcp/
.DS_Store
.vscode
.idea

# Fly.io deployment config — the Pi deployment uses homelab-pi/docker-compose.yml.
# Kept in the repo for reference, but it has no meaning inside the image.
fly.toml
